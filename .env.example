# Kopiér til .env.local og udfyld. Kun VITE_-variabler kommer med i browser-bundlet.
# Find værdierne i Supabase: Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Den offentlige anon/publishable key. Den er beregnet til browseren; sikkerheden ligger i RLS.
VITE_SUPABASE_ANON_KEY=

# ALDRIG her: service_role / secret key. Den hører kun hjemme i Supabase Edge Function secrets.
